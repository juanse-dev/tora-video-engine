{
  "name": "tora-video-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Declarative video engine built with Remotion",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts",
    "render:smoke": "remotion render src/index.ts ToraVideo output/smoke.mp4 --codec=h264",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint src && tsc"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.529",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.529",
    "@types/node": "22.18.8",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  }
}
